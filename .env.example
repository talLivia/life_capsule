# AWS Configuration — kept only for the base project's optional Terraform/
# EC2 GPU deploy path (infrastructure/). NOT used for object storage in
# this project; raw video/audio goes to Cloudflare R2 (see below).
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=avatar-system-storage
CLOUDFRONT_DOMAIN=

# Database Configuration
# Local/Docker Compose dev uses this directly. In every deployed
# environment this points at Neon Postgres instead — grab the pooled
# connection string from the Neon dashboard (Connect > Pooled connection)
# and append ?sslmode=require, e.g.:
#   DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://avatar_user:change_this_password@postgres:5432/avatar_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=change_this_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Graph / associative memory — Graphiti, backed by Neo4j AuraDB.
# Create a free/small AuraDB instance at https://console.neo4j.io, then
# copy the connection URI it gives you (starts with neo4j+s://) plus the
# generated password. Used by graph_memory.py (Prompt 3).
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_generated_password
# Some AuraDB instances use a database name matching their instance id
# instead of the usual "neo4j" — check your AuraDB connection details.
NEO4J_DATABASE=neo4j

# Graphiti's OWN internal LLM (extraction) and embedder — independent of
# LLM_PROVIDER above. The project plan specifies Claude for extraction;
# "gemini" (default here) is a fully cloud-based, cheaper alternative for
# iteration — get a key at https://aistudio.google.com/apikey. Swap both
# back to anthropic/openai before relying on real ingestion quality.
# Model names verified live against a real key — "gemini-2.0-flash" /
# "text-embedding-001" (Graphiti's own docs example) turned out to be
# unavailable to new API keys; run
#   python -c "from google import genai; [print(m.name) for m in genai.Client(api_key='...').models.list()]"
# against your own key if these ever stop working again.
GRAPHITI_LLM_PROVIDER=gemini
GRAPHITI_LLM_MODEL=gemini-flash-latest
# graphiti-core's GeminiClient also uses a separate, cheaper "small_model"
# internally, defaulting to "gemini-2.5-flash-lite" — also unavailable to
# new API keys, so set it explicitly too.
GRAPHITI_LLM_SMALL_MODEL=gemini-flash-lite-latest
GRAPHITI_EMBEDDER_PROVIDER=gemini
GRAPHITI_EMBEDDING_MODEL=gemini-embedding-001
GRAPHITI_EMBEDDING_DIM=3072
# Used by both GRAPHITI_LLM_PROVIDER=gemini and GRAPHITI_EMBEDDER_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 (object storage for raw interview video/audio)
# Create a bucket + R2 API token in the Cloudflare dashboard (R2 > Manage
# API tokens). R2_ENDPOINT is your account's S3-compatible endpoint:
#   https://<account_id>.r2.cloudflarestorage.com
#
# Set USE_LOCAL_STORAGE=false to actually use R2 (leave =true, the default,
# for quick local dev against the filesystem instead — see docker-compose.yml).
USE_LOCAL_STORAGE=true
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=life-capsule-segments
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional: only set this if the bucket is exposed via an R2 custom domain
# for direct reads. Leave blank to always use presigned GET URLs instead.
R2_PUBLIC_URL=

# API Keys
# Anthropic (Claude) is the only model that ever touches the storyteller's
# actual recorded content — entity extraction, topic/importance
# classification, retrieval-time topic matching (Prompts 3, 5, 6). It is
# never used for open-ended chat; see backend/app/services/llm.py.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Application Settings
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Configuration
# anthropic | openai | ollama (local & free — runs against http://localhost:11434/v1)
LLM_PROVIDER=anthropic
# Claude (2026): claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5
# OpenAI: e.g. gpt-4o, gpt-4o-mini (also requires LLM_PROVIDER=openai)
# Ollama: e.g. llama3.1, qwen2.5 (requires LLM_PROVIDER=ollama)
LLM_MODEL=claude-sonnet-4-6
# Optional: point the OpenAI-compatible client elsewhere (Ollama, vLLM,
# LM Studio, OpenRouter). Leave empty for api.openai.com.
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Avatar Engine
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512

# STT Configuration
STT_PROVIDER=whisper
# tiny | base | small | medium | large-v3 | large-v3-turbo
# large-v3-turbo: best 2026 sweet spot — recommended for GPU. Fall back to base/small on CPU.
WHISPER_MODEL=large-v3-turbo

# TTS Configuration
# chatterbox (voice cloning, 23 languages). Automatic fallback chain when the
# model can't load: edge-tts (free neural voices) -> gtts.
TTS_PROVIDER=chatterbox
TTS_VOICE=default

# Security
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Video Settings
VIDEO_FPS=25
VIDEO_CODEC=h264
VIDEO_BITRATE=2000k

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
