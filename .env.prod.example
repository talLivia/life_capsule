# ============================================================
# Production Environment — copy to .env.prod and fill in values
#
# NOTE: this file is inherited from the base project's AWS/EC2 template.
# This project's actual live topology (Fly.io + Neon + Neo4j AuraDB + R2 +
# Upstash + Runpod) is provisioned in Prompt 2 — treat AWS/RDS/ElastiCache
# references below as placeholders until that pass.
# ============================================================

# AWS — only relevant if deploying GPU inference via the base project's EC2
# path instead of Runpod. Not used for object storage (see R2 below).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-avatar-bucket
CLOUDFRONT_DOMAIN=

# Database — Neon Postgres pooled connection string (Connect > Pooled
# connection in the Neon dashboard), with ?sslmode=require appended.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=STRONG_PASSWORD_HERE

# Redis — Upstash (managed, serverless-friendly) in production.
#
# ⚠️ This MUST be the rediss:// string from the Upstash console. It previously
# read `redis://redis:6379/0` — the docker-compose SERVICE HOSTNAME, which does
# not resolve on Fly.io. Copying that value into a Fly deploy pointed the cache
# at a host that does not exist.
#
# That failure is silent by design elsewhere: cache_service falls back to
# no-op on a failed connect (see app/services/cache.py), so the clip cache
# just quietly stops working and every answer re-runs ffmpeg. /health now
# reports "unreachable: ..." and marks the app degraded — check it after
# changing this value.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Celery — used ONLY by the self-hosted docker-compose.prod.yml path, which
# brings up its own `redis` service (hence these hostnames, which are correct
# there). The Fly.io deploy sets no Celery secrets at all; see
# docs/deployment.md, which sets REDIS_URL and nothing else.
# If you ever point Celery at Upstash, check whether that instance exposes the
# /1 and /2 database indices — a managed Redis may serve only one database.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embeddings. ⚠️ Changing these invalidates every stored embedding — see
# .env.example. gemini-flash-latest hit sustained 503 "high demand" errors in
# testing, which is why the LLM models below are the -lite ones. Since
# 2026-08-16 the archive-read model is PINNED (gemini-3.6-flash), never the
# moving alias — see PROJECT_STATUS for the incident that decided this.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
GEMINI_API_KEY=

# Cloudflare R2 — object storage for raw interview video/audio
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=life-capsule-segments
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# API Keys
# Whichever provider LLM_PROVIDER selects below is the only model used
# against real story content — never for open-ended chat. See
# backend/app/services/llm.py. This project consolidates on Gemini
# (GEMINI_API_KEY above) rather than funding Anthropic separately;
# ANTHROPIC_API_KEY only matters if you switch LLM_PROVIDER back.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
ELEVENLABS_API_KEY=

# Application
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Avatar Engine — musetalk for GPU lip-sync, simple for fallback
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512
AVATAR_FPS=25
MUSETALK_PATH=models/MuseTalk

# Storage — R2 in production (see R2_* above); local storage stays off
USE_LOCAL_STORAGE=false
STORAGE_PROVIDER=r2
LOCAL_STORAGE_PATH=uploads

# LLM
LLM_PROVIDER=gemini
# PINNED, never the moving alias (see the MODEL VERSIONS policy in the
# dev .env / PROJECT_STATUS 2026-08-16).
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# TTS
TTS_PROVIDER=chatterbox
TTS_VOICE=default

# STT
STT_PROVIDER=whisper
WHISPER_MODEL=base

# GPU-service split (Prompt 9) — set on the Fly.io backend to proxy
# STT/TTS/lip-sync calls to a persistent Runpod GPU pod instead of running
# them in-process. Leave GPU_SERVICE_URL unset on the Runpod pod itself
# (and on Fly if you're not splitting) so it falls back to local in-process
# calls. See docs/deployment.md, section 6.
GPU_SERVICE_URL=
GPU_SERVICE_SHARED_SECRET=generate-with-openssl-rand-hex-32
GPU_SERVICE_TIMEOUT_SECONDS=60

# Frontend (point to your domain / EC2 public IP)
BACKEND_URL=https://yourdomain.com
WS_URL=wss://yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
