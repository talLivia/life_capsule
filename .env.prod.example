# ============================================================
# Production Environment — copy to .env.prod and fill in values
#
# NOTE: this file is inherited from the base project's AWS/EC2 template.
# This project's actual live topology (Fly.io + Neon + Neo4j AuraDB + R2 +
# Upstash + Runpod) is provisioned in Prompt 2 — treat AWS/RDS/ElastiCache
# references below as placeholders until that pass.
# ============================================================

# AWS — only relevant if deploying GPU inference via the base project's EC2
# path instead of Runpod. Not used for object storage (see R2 below).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-avatar-bucket
CLOUDFRONT_DOMAIN=

# Database — Neon Postgres pooled connection string (Connect > Pooled
# connection in the Neon dashboard), with ?sslmode=require appended.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=STRONG_PASSWORD_HERE

# Redis — Upstash (managed, serverless-friendly) in production
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Graph / associative memory — Neo4j AuraDB (Graphiti backend)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_generated_password

# Cloudflare R2 — object storage for raw interview video/audio
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=life-capsule-segments
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# API Keys
# Anthropic (Claude) is the only model used against real story content —
# never for open-ended chat. See backend/app/services/llm.py.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
ELEVENLABS_API_KEY=

# Application
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Avatar Engine — musetalk for GPU lip-sync, simple for fallback
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512
AVATAR_FPS=25
MUSETALK_PATH=models/MuseTalk

# Storage — R2 in production (see R2_* above); local storage stays off
USE_LOCAL_STORAGE=false
STORAGE_PROVIDER=r2
LOCAL_STORAGE_PATH=uploads

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# TTS
TTS_PROVIDER=chatterbox
TTS_VOICE=default

# STT
STT_PROVIDER=whisper
WHISPER_MODEL=base

# Frontend (point to your domain / EC2 public IP)
BACKEND_URL=https://yourdomain.com
WS_URL=wss://yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
